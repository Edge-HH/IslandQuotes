<ci:ComponentBase x:Class="IslandQuotes.Components.QuoteAi.QuoteAiSettings"
                  x:TypeArguments="local:QuoteAiConfig"
                  xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:IslandQuotes.Components.QuoteAi"
                  xmlns:ci="http://classisland.tech/schemas/xaml/core"
                  xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                  mc:Ignorable="d" d:DesignHeight="560" d:DesignWidth="420"
                  AttachedToVisualTree="OnAttachedToVisualTree">
    <ScrollViewer DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:QuoteAiSettings}}">
        <StackPanel Classes="settings-container animated-intro">
            <Border Background="#204169e1"
                    CornerRadius="4"
                    Margin="0 0 0 5">
                <DockPanel Margin="8 4">
                    <ci:FluentIcon Glyph="&#xE9E3;"/>
                    <TextBlock TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="4 2 0 0">
                        <Run>本组件展示的内容</Run><Bold>均由第三方服务商提供给你</Bold>
                        <Run> 我们不对其内容做任何担保</Run>
                    </TextBlock>
                </DockPanel>
            </Border>
            <Grid ColumnDefinitions="*,Auto" Margin="4 8 0 4">
                <TextBlock Grid.Column="0"
                           Text="内容来源"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6 2"
                        ToolTip.Tip="添加自定义来源"
                        Click="AddCustomSourceButton_OnClick">
                    <ci:FluentIcon Glyph="&#xE00D;"/>
                </Button>
            </Grid>
            <ItemsControl ItemsSource="{Binding ProviderItems}" Margin="0,0,0,-2">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE21D;}"
                                             Header="{Binding DisplayName}"
                                             Description="{Binding Description}"
                                             IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                             Margin="0,2">
                            <fa:SettingsExpander.Footer>
                                <ToggleSwitch IsChecked="{Binding Configuration.IsEnabled, Mode=TwoWay}"/>
                            </fa:SettingsExpander.Footer>
                            <fa:SettingsExpander.Items>
                                <fa:SettingsExpanderItem Content="概率权重"
                                                         Description="数值越大，被选中的概率越高；设为 0 等同于不参与选择">
                                    <fa:SettingsExpanderItem.Footer>
                                        <NumericUpDown Value="{Binding Configuration.Weight, Mode=TwoWay}"
                                                       Minimum="0"
                                                       Maximum="10000"
                                                       FormatString="0"
                                                       InputMethod.IsInputMethodEnabled="False"
                                                       MinWidth="60"/>
                                    </fa:SettingsExpanderItem.Footer>
                                </fa:SettingsExpanderItem>
                                <fa:SettingsExpanderItem Content="对该来源启用 AI 审查">
                                    <fa:SettingsExpanderItem.Footer>
                                        <ToggleSwitch IsChecked="{Binding Configuration.IsAiReviewEnabled, Mode=TwoWay}"/>
                                    </fa:SettingsExpanderItem.Footer>
                                </fa:SettingsExpanderItem>
                                <fa:SettingsExpanderItem Content="来源配置"
                                                         IsVisible="{Binding HasSettings}">
                                    <fa:SettingsExpanderItem.Footer>
                                        <ContentControl Content="{Binding SettingsControl}"/>
                                    </fa:SettingsExpanderItem.Footer>
                                </fa:SettingsExpanderItem>
                                <fa:SettingsExpanderItem Content="名称"
                                                         IsVisible="{Binding IsCustom}">
                                    <fa:SettingsExpanderItem.Footer>
                                        <TextBox Text="{Binding CustomSource.Name, Mode=TwoWay}"
                                                 MinWidth="160"
                                                 MaxWidth="260"/>
                                    </fa:SettingsExpanderItem.Footer>
                                </fa:SettingsExpanderItem>
                                <fa:SettingsExpanderItem Content="播放顺序"
                                                         Description="顺序播放会记忆上次播放到的位置"
                                                         IsVisible="{Binding IsCustom}">
                                    <fa:SettingsExpanderItem.Footer>
                                        <ComboBox MinWidth="20"
                                                  SelectedIndex="{Binding CustomSource.PlayModeIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="顺序播放"/>
                                            <ComboBoxItem Content="随机播放"/>
                                        </ComboBox>
                                    </fa:SettingsExpanderItem.Footer>
                                </fa:SettingsExpanderItem>
                                <fa:SettingsExpanderItem Content="自定义内容"
                                                         Description="一行一条；可从本地文本文件(txt)导入，导入的内容追加到末尾"
                                                         IsVisible="{Binding IsCustom}">
                                    <fa:SettingsExpanderItem.Footer>
                                        <Button Tag="{Binding}"
                                                ToolTip.Tip="从本地导入"
                                                Click="ImportCustomSourceButton_OnClick">
                                            <ci:FluentIcon Glyph="&#xE105;"/>
                                        </Button>
                                    </fa:SettingsExpanderItem.Footer>
                                </fa:SettingsExpanderItem>
                                <fa:SettingsExpanderItem IsVisible="{Binding IsCustom}">
                                    <TextBox Text="{Binding CustomSource.Content, Mode=TwoWay}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             MinHeight="80"
                                             MaxHeight="300"
                                             Watermark="每行一条内容"/>
                                </fa:SettingsExpanderItem>
                                <fa:SettingsExpanderItem Content="删除该来源"
                                                         IsVisible="{Binding IsCustom}">
                                    <fa:SettingsExpanderItem.Footer>
                                        <Button Tag="{Binding}"
                                                ToolTip.Tip="删除该来源"
                                                Click="RemoveCustomSourceButton_OnClick">
                                            <ci:FluentIcon Glyph="&#xE61D;"/>
                                        </Button>
                                    </fa:SettingsExpanderItem.Footer>
                                </fa:SettingsExpanderItem>
                            </fa:SettingsExpander.Items>
                        </fa:SettingsExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="StatusText"
                       IsVisible="False"
                       TextWrapping="Wrap"
                       Foreground="Gray"
                       Margin="4 2 4 4"/>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xF321;}"
                                 Header="字数限制"
                                 Description="当字数大于该设置时,不显示并重新获取(一言为API级限制),设为0即禁用">
                <fa:SettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.LengthLimitation, Mode=TwoWay}"
                                   VerticalAlignment="Center"
                                   FormatString="0"
                                   Minimum="0"
                                   InputMethod.IsInputMethodEnabled="False"
                                   MinWidth="30"/>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xEF75;}"
                                 Header="刷新间隔"
                                 Description="设定自动刷新的时间间隔,单位为秒,设为0即禁用">
                <fa:SettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.UpdateTimeGapSeconds, Mode=TwoWay}"
                                   VerticalAlignment="Center"
                                   FormatString="0.0"
                                   Minimum="0"
                                   InputMethod.IsInputMethodEnabled="False"
                                   MinWidth="30"/>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xEBFA;}"
                                 Header="额外信息展示方法"
                                 Description="选择如何展示额外信息,没有则不展示">
                <fa:SettingsExpander.Footer>
                    <ComboBox MinWidth="20"
                              SelectedIndex="{Binding Settings.AttributesRuleIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="同时展示"/>
                        <ComboBoxItem Content="分开展示"/>
                    </ComboBox>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xEC0C;}"
                                 Header="展示作者"
                                 Description="将作者作为额外信息展示,未获取到则不显示">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsAuthorShowEnabled, Mode=TwoWay}"/>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xEC08;}"
                                 Header="展示出处"
                                 Description="将出处作为额外信息展示,未获取到则不显示">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsTitleShowEnabled, Mode=TwoWay}"/>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xEE39;}"
                                 IsVisible="{Binding Settings.IsAttributesSeparate}"
                                 Header="额外信息展示时长"
                                 Description="设置额外信息被展示的时长">
                <fa:SettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.AttributesShowingInterval, Mode=TwoWay}"
                                   VerticalAlignment="Center"
                                   FormatString="0"
                                   Minimum="0"
                                   Maximum="{Binding Settings.UpdateTimeGapSeconds}"
                                   InputMethod.IsInputMethodEnabled="False"
                                   MinWidth="30"/>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE051;}"
                                 Header="启用动画"
                                 Description="禁用后,将不再播放动画,对低性能设备友好!">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsAnimationEnabled, Mode=TwoWay}"/>
                </fa:SettingsExpander.Footer>
                <fa:SettingsExpander.Items>
                    <fa:SettingsExpanderItem IconSource="{ci:FluentIconSource &#xE095;}"
                                             Content="启用翻页动画"
                                             Description="启用后,切换动画样式将被替换为翻页(额外信息不受影响)">
                        <fa:SettingsExpanderItem.Footer>
                            <ToggleSwitch IsChecked="{Binding Settings.IsSwapAnimationEnabled, Mode=TwoWay}"/>
                        </fa:SettingsExpanderItem.Footer>
                    </fa:SettingsExpanderItem>
                </fa:SettingsExpander.Items>
            </fa:SettingsExpander>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE3DA;}"
                                 Header="排除列表"
                                 Description="包含位于此列表中的字符串的内容更新将被忽略,一行一个;可从文本文件导入(文件不超过1MB,总计不超过5000条)">
                <fa:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Click="ImportIgnoreListButton_OnClick">
                            <ci:FluentIcon Glyph="&#xE105;"/>
                        </Button>
                        <ci:FluentIcon Glyph="&#xEBD8;"/>
                    </StackPanel>
                </fa:SettingsExpander.Footer>
                <TextBox Text="{Binding Settings.IgnoreListString, Mode=TwoWay}"
                         Background="Transparent"
                         AcceptsReturn="True"
                         VerticalContentAlignment="Top"
                         TextWrapping="Wrap"
                         Margin="6,6,6,6"/>
            </fa:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</ci:ComponentBase>
