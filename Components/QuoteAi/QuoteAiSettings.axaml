<ci:ComponentBase x:Class="IslandQuotes.Components.QuoteAi.QuoteAiSettings"
                  x:TypeArguments="local:QuoteAiConfig"
                  xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:IslandQuotes.Components.QuoteAi"
                  xmlns:ci="http://classisland.tech/schemas/xaml/core"
                  xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                  mc:Ignorable="d" d:DesignHeight="560" d:DesignWidth="420"
                  AttachedToVisualTree="OnAttachedToVisualTree">
    <ScrollViewer x:Name="RootScrollViewer">
        <StackPanel Classes="settings-container animated-intro">
            <Border Background="#204169e1"
                    CornerRadius="4"
                    Margin="0 0 0 5">
                <DockPanel Margin="8 4">
                    <ci:FluentIcon Glyph="&#xE9E3;"/>
                    <TextBlock TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="4 2 0 0">
                        <Run>本组件展示的内容</Run><Bold>均由第三方服务商提供给你</Bold>
                        <Run> 我们不对其内容做任何担保</Run>
                    </TextBlock>
                </DockPanel>
            </Border>
            <Grid ColumnDefinitions="*,Auto" Margin="4 8 0 4">
                <TextBlock Grid.Column="0"
                           Text="内容来源"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="1"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="6 2"
                        ToolTip.Tip="添加自定义来源"
                        Click="AddCustomSourceButton_OnClick">
                    <ci:FluentIcon Glyph="&#xE00D;"/>
                </Button>
            </Grid>
            <ItemsControl ItemsSource="{Binding ProviderItems}" Margin="0,0,0,-2">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE21D;}"
                                             Header="{Binding DisplayName}"
                                             Description="{Binding Description}"
                                             IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                             Margin="0,2">
                            <fa:SettingsExpander.Footer>
                                <ToggleSwitch IsChecked="{Binding Configuration.IsEnabled, Mode=TwoWay}"/>
                            </fa:SettingsExpander.Footer>
                            <fa:SettingsExpander.Items>
                                <fa:SettingsExpanderItem Content="概率权重"
                                                         Description="数值越大，被选中的概率越高；设为 0 等同于不参与选择">
                                    <fa:SettingsExpanderItem.Footer>
                                        <NumericUpDown Value="{Binding Configuration.Weight, Mode=TwoWay}"
                                                       Minimum="0"
                                                       Maximum="10000"
                                                       FormatString="0"
                                                       InputMethod.IsInputMethodEnabled="False"
                                                       MinWidth="60"/>
                                    </fa:SettingsExpanderItem.Footer>
                                </fa:SettingsExpanderItem>
                                <fa:SettingsExpanderItem Content="对该来源启用 AI 审查">
                                    <fa:SettingsExpanderItem.Footer>
                                        <ToggleSwitch IsChecked="{Binding Configuration.IsAiReviewEnabled, Mode=TwoWay}"/>
                                    </fa:SettingsExpanderItem.Footer>
                                </fa:SettingsExpanderItem>
                                <fa:SettingsExpanderItem Content="来源配置"
                                                         IsVisible="{Binding HasSettings}">
                                    <fa:SettingsExpanderItem.Footer>
                                        <ContentControl Content="{Binding SettingsControl}"/>
                                    </fa:SettingsExpanderItem.Footer>
                                </fa:SettingsExpanderItem>
                                <fa:SettingsExpanderItem Content="名称"
                                                         IsVisible="{Binding IsCustom}">
                                    <fa:SettingsExpanderItem.Footer>
                                        <TextBox Text="{Binding CustomSource.Name, Mode=TwoWay}"
                                                 MinWidth="160"
                                                 MaxWidth="260"/>
                                    </fa:SettingsExpanderItem.Footer>
                                </fa:SettingsExpanderItem>
                                <fa:SettingsExpanderItem Content="播放顺序"
                                                         Description="顺序播放会记忆上次播放到的位置"
                                                         IsVisible="{Binding IsCustom}">
                                    <fa:SettingsExpanderItem.Footer>
                                        <ComboBox MinWidth="20"
                                                  SelectedIndex="{Binding CustomSource.PlayModeIndex, Mode=TwoWay}">
                                            <ComboBoxItem Content="顺序播放"/>
                                            <ComboBoxItem Content="随机播放"/>
                                        </ComboBox>
                                    </fa:SettingsExpanderItem.Footer>
                                </fa:SettingsExpanderItem>
                                <fa:SettingsExpanderItem Content="自定义内容"
                                                         Description="一行一条；可从本地文本文件(txt)导入，导入的内容追加到末尾"
                                                         IsVisible="{Binding IsCustom}">
                                    <fa:SettingsExpanderItem.Footer>
                                        <Button Tag="{Binding}"
                                                ToolTip.Tip="从本地导入"
                                                Click="ImportCustomSourceButton_OnClick">
                                            <ci:FluentIcon Glyph="&#xE105;"/>
                                        </Button>
                                    </fa:SettingsExpanderItem.Footer>
                                </fa:SettingsExpanderItem>
                                <fa:SettingsExpanderItem IsVisible="{Binding IsCustom}">
                                    <TextBox Text="{Binding CustomSource.Content, Mode=TwoWay}"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             VerticalContentAlignment="Top"
                                             MinHeight="80"
                                             MaxHeight="300"
                                             Watermark="每行一条内容"/>
                                </fa:SettingsExpanderItem>
                                <fa:SettingsExpanderItem Content="删除该来源"
                                                         IsVisible="{Binding IsCustom}">
                                    <fa:SettingsExpanderItem.Footer>
                                        <Button Tag="{Binding}"
                                                ToolTip.Tip="删除该来源"
                                                Click="RemoveCustomSourceButton_OnClick">
                                            <ci:FluentIcon Glyph="&#xE61D;"/>
                                        </Button>
                                    </fa:SettingsExpanderItem.Footer>
                                </fa:SettingsExpanderItem>
                            </fa:SettingsExpander.Items>
                        </fa:SettingsExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="StatusText"
                       IsVisible="False"
                       TextWrapping="Wrap"
                       Foreground="Gray"
                       Margin="4 2 4 4"/>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xF321;}"
                                 Header="字数限制"
                                 Description="当字数大于该设置时,不显示并重新获取(一言为API级限制),设为0即禁用">
                <fa:SettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.LengthLimitation, Mode=TwoWay}"
                                   VerticalAlignment="Center"
                                   FormatString="0"
                                   Minimum="0"
                                   InputMethod.IsInputMethodEnabled="False"
                                   MinWidth="30"/>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xEF75;}"
                                 Header="刷新间隔"
                                 Description="设定自动刷新的时间间隔,单位为秒,设为0即禁用(仍会显示一次队列内容);最大 86400 秒">
                <fa:SettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.UpdateTimeGapSeconds, Mode=TwoWay}"
                                   VerticalAlignment="Center"
                                   FormatString="0.0"
                                   Minimum="0"
                                   Maximum="86400"
                                   InputMethod.IsInputMethodEnabled="False"
                                   MinWidth="30"/>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xEBFA;}"
                                 Header="额外信息展示方法"
                                 Description="选择如何展示额外信息,没有则不展示">
                <fa:SettingsExpander.Footer>
                    <ComboBox MinWidth="20"
                              SelectedIndex="{Binding Settings.AttributesRuleIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="同时展示"/>
                        <ComboBoxItem Content="分开展示"/>
                    </ComboBox>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xEC0C;}"
                                 Header="展示作者"
                                 Description="将作者作为额外信息展示,未获取到则不显示">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsAuthorShowEnabled, Mode=TwoWay}"/>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xEC08;}"
                                 Header="展示出处"
                                 Description="将出处作为额外信息展示,未获取到则不显示">
                <fa:SettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding Settings.IsTitleShowEnabled, Mode=TwoWay}"/>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xEE39;}"
                                 IsVisible="{Binding Settings.IsAttributesSeparate}"
                                 Header="额外信息展示时长"
                                 Description="内容显示多久后切换为额外信息;实际不超过刷新间隔">
                <fa:SettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.AttributesShowingInterval, Mode=TwoWay}"
                                   VerticalAlignment="Center"
                                   FormatString="0"
                                   Minimum="0"
                                   Maximum="86400"
                                   InputMethod.IsInputMethodEnabled="False"
                                   MinWidth="30"/>
                </fa:SettingsExpander.Footer>
            </fa:SettingsExpander>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE051;}"
                                 Header="切换动画"
                                 Description="选择内容切换时播放的动画">
                <fa:SettingsExpander.Footer>
                    <ComboBox MinWidth="120"
                              SelectedIndex="{Binding Settings.ContentAnimationModeIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="无"/>
                        <ComboBoxItem Content="渐入渐出"/>
                        <ComboBoxItem Content="向上翻页"/>
                        <ComboBoxItem Content="向下翻页"/>
                        <ComboBoxItem Content="向左翻页"/>
                        <ComboBoxItem Content="向右翻页"/>
                        <ComboBoxItem Content="扫光"/>
                    </ComboBox>
                </fa:SettingsExpander.Footer>
                <fa:SettingsExpander.Items>
                    <fa:SettingsExpanderItem Content="扫光颜色"
                                             Description="自定义扫过文字的高光颜色，支持 #AARRGGBB 透明度；">
                        <fa:SettingsExpanderItem.Footer>
                            <StackPanel Spacing="4">
                                <DockPanel>
                                    <Border Width="20"
                                            Height="20"
                                            Margin="0 0 6 0"
                                            CornerRadius="3"
                                            BorderBrush="#40808080"
                                            BorderThickness="1"
                                            Background="{Binding Settings.ShimmerBrush}"/>
                                    <TextBox Text="{Binding Settings.ShimmerColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Watermark="自动（半透明）"
                                             MinWidth="140"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="#FFFFFF" ToolTip.Tip="#FFFFFF" Click="ShimmerColorPresetButton_OnClick">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#FFFFFF" BorderBrush="#40808080" BorderThickness="1"/>
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="#000000" ToolTip.Tip="#000000" Click="ShimmerColorPresetButton_OnClick">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#000000" BorderBrush="#40808080" BorderThickness="1"/>
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="#FFD166" ToolTip.Tip="#FFD166" Click="ShimmerColorPresetButton_OnClick">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#FFD166" BorderBrush="#40808080" BorderThickness="1"/>
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="#7CC8FF" ToolTip.Tip="#7CC8FF" Click="ShimmerColorPresetButton_OnClick">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#7CC8FF" BorderBrush="#40808080" BorderThickness="1"/>
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="#7ED9A0" ToolTip.Tip="#7ED9A0" Click="ShimmerColorPresetButton_OnClick">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#7ED9A0" BorderBrush="#40808080" BorderThickness="1"/>
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="#FF9F9F" ToolTip.Tip="#FF9F9F" Click="ShimmerColorPresetButton_OnClick">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#FF9F9F" BorderBrush="#40808080" BorderThickness="1"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </fa:SettingsExpanderItem.Footer>
                    </fa:SettingsExpanderItem>
                </fa:SettingsExpander.Items>
            </fa:SettingsExpander>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xF26F;}"
                                 Header="文字样式"
                                 Description="自定义主界面文字的字体、字号与颜色">
                <fa:SettingsExpander.Items>
                    <fa:SettingsExpanderItem Content="字体" Description="留空使用主界面字体">
                        <fa:SettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <ComboBox x:Name="FontFamilyComboBox"
                                          IsEditable="True"
                                          MinWidth="160"
                                          MaxWidth="240"
                                          PlaceholderText="继承主界面字体"
                                          Text="{Binding Settings.MainFontFamilyName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectionChanged="FontFamilyComboBox_OnSelectionChanged"
                                          LostFocus="FontFamilyComboBox_OnLostFocus"/>
                                <Button Content="继承"
                                        Padding="8 4"
                                        ToolTip.Tip="使用主界面字体"
                                        Click="ResetFontFamilyButton_OnClick"/>
                            </StackPanel>
                        </fa:SettingsExpanderItem.Footer>
                    </fa:SettingsExpanderItem>
                    <fa:SettingsExpanderItem Content="字号" Description="设为 0 使用主界面默认字号">
                        <fa:SettingsExpanderItem.Footer>
                            <NumericUpDown Value="{Binding Settings.MainFontSize, Mode=TwoWay}"
                                           VerticalAlignment="Center"
                                           FormatString="0"
                                           Minimum="0"
                                           Maximum="200"
                                           InputMethod.IsInputMethodEnabled="False"
                                           MinWidth="60"/>
                        </fa:SettingsExpanderItem.Footer>
                    </fa:SettingsExpanderItem>
                    <fa:SettingsExpanderItem Content="字重">
                        <fa:SettingsExpanderItem.Footer>
                            <ComboBox MinWidth="20"
                                      SelectedIndex="{Binding Settings.MainFontWeightIndex, Mode=TwoWay}">
                                <ComboBoxItem Content="继承"/>
                                <ComboBoxItem Content="常规"/>
                                <ComboBoxItem Content="中等"/>
                                <ComboBoxItem Content="半粗"/>
                                <ComboBoxItem Content="粗体"/>
                                <ComboBoxItem Content="特粗"/>
                                <ComboBoxItem Content="极粗"/>
                            </ComboBox>
                        </fa:SettingsExpanderItem.Footer>
                    </fa:SettingsExpanderItem>
                    <fa:SettingsExpanderItem Content="垂直位置"
                                             Description="上下微调文字位置，单位像素；负数上移，正数下移">
                        <fa:SettingsExpanderItem.Footer>
                            <NumericUpDown Value="{Binding Settings.TextVerticalOffset, Mode=TwoWay}"
                                           VerticalAlignment="Center"
                                           FormatString="0"
                                           Minimum="-200"
                                           Maximum="200"
                                           InputMethod.IsInputMethodEnabled="False"
                                           MinWidth="70"/>
                        </fa:SettingsExpanderItem.Footer>
                    </fa:SettingsExpanderItem>
                    <fa:SettingsExpanderItem Content="文字颜色"
                                             Description="支持 #RRGGBB、#AARRGGBB 或颜色名；留空使用主界面颜色">
                        <fa:SettingsExpanderItem.Footer>
                            <StackPanel Spacing="4">
                                <DockPanel>
                                    <Border Width="20"
                                            Height="20"
                                            Margin="0 0 6 0"
                                            CornerRadius="3"
                                            BorderBrush="#40808080"
                                            BorderThickness="1"
                                            Background="{Binding Settings.MainTextBrush}"/>
                                    <TextBox Text="{Binding Settings.MainTextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Watermark="#FFFFFF"
                                             MinWidth="140"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="#FFFFFF" ToolTip.Tip="#FFFFFF" Click="MainColorPresetButton_OnClick">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#FFFFFF" BorderBrush="#40808080" BorderThickness="1"/>
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="#E0E0E0" ToolTip.Tip="#E0E0E0" Click="MainColorPresetButton_OnClick">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#E0E0E0" BorderBrush="#40808080" BorderThickness="1"/>
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="#9E9E9E" ToolTip.Tip="#9E9E9E" Click="MainColorPresetButton_OnClick">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#9E9E9E" BorderBrush="#40808080" BorderThickness="1"/>
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="#FFD166" ToolTip.Tip="#FFD166" Click="MainColorPresetButton_OnClick">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#FFD166" BorderBrush="#40808080" BorderThickness="1"/>
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="#7CC8FF" ToolTip.Tip="#7CC8FF" Click="MainColorPresetButton_OnClick">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#7CC8FF" BorderBrush="#40808080" BorderThickness="1"/>
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="#7ED9A0" ToolTip.Tip="#7ED9A0" Click="MainColorPresetButton_OnClick">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#7ED9A0" BorderBrush="#40808080" BorderThickness="1"/>
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="#FF9F9F" ToolTip.Tip="#FF9F9F" Click="MainColorPresetButton_OnClick">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#FF9F9F" BorderBrush="#40808080" BorderThickness="1"/>
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="#C9A7FF" ToolTip.Tip="#C9A7FF" Click="MainColorPresetButton_OnClick">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#C9A7FF" BorderBrush="#40808080" BorderThickness="1"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </fa:SettingsExpanderItem.Footer>
                    </fa:SettingsExpanderItem>
                </fa:SettingsExpander.Items>
            </fa:SettingsExpander>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xF263;}"
                                 Header="额外信息样式"
                                 Description="作者与出处的字号和颜色">
                <fa:SettingsExpander.Items>
                    <fa:SettingsExpanderItem Content="字号" Description="设为 0 使用主界面默认字号">
                        <fa:SettingsExpanderItem.Footer>
                            <NumericUpDown Value="{Binding Settings.AttributionFontSize, Mode=TwoWay}"
                                           VerticalAlignment="Center"
                                           FormatString="0"
                                           Minimum="0"
                                           Maximum="200"
                                           InputMethod.IsInputMethodEnabled="False"
                                           MinWidth="60"/>
                        </fa:SettingsExpanderItem.Footer>
                    </fa:SettingsExpanderItem>
                    <fa:SettingsExpanderItem Content="颜色"
                                             Description="支持 #RRGGBB、#AARRGGBB 或颜色名；留空使用主界面颜色">
                        <fa:SettingsExpanderItem.Footer>
                            <StackPanel Spacing="4">
                                <DockPanel>
                                    <Border Width="20"
                                            Height="20"
                                            Margin="0 0 6 0"
                                            CornerRadius="3"
                                            BorderBrush="#40808080"
                                            BorderThickness="1"
                                            Background="{Binding Settings.AttributionTextBrush}"/>
                                    <TextBox Text="{Binding Settings.AttributionTextColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Watermark="#FFFFFF"
                                             MinWidth="140"/>
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="#FFFFFF" ToolTip.Tip="#FFFFFF" Click="AttributionColorPresetButton_OnClick">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#FFFFFF" BorderBrush="#40808080" BorderThickness="1"/>
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="#E0E0E0" ToolTip.Tip="#E0E0E0" Click="AttributionColorPresetButton_OnClick">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#E0E0E0" BorderBrush="#40808080" BorderThickness="1"/>
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="#9E9E9E" ToolTip.Tip="#9E9E9E" Click="AttributionColorPresetButton_OnClick">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#9E9E9E" BorderBrush="#40808080" BorderThickness="1"/>
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="#FFD166" ToolTip.Tip="#FFD166" Click="AttributionColorPresetButton_OnClick">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#FFD166" BorderBrush="#40808080" BorderThickness="1"/>
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="#7CC8FF" ToolTip.Tip="#7CC8FF" Click="AttributionColorPresetButton_OnClick">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#7CC8FF" BorderBrush="#40808080" BorderThickness="1"/>
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="#7ED9A0" ToolTip.Tip="#7ED9A0" Click="AttributionColorPresetButton_OnClick">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#7ED9A0" BorderBrush="#40808080" BorderThickness="1"/>
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="#FF9F9F" ToolTip.Tip="#FF9F9F" Click="AttributionColorPresetButton_OnClick">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#FF9F9F" BorderBrush="#40808080" BorderThickness="1"/>
                                    </Button>
                                    <Button Width="22" Height="22" Padding="0" Background="Transparent" BorderThickness="0" Tag="#C9A7FF" ToolTip.Tip="#C9A7FF" Click="AttributionColorPresetButton_OnClick">
                                        <Border Width="14" Height="14" CornerRadius="7" Background="#C9A7FF" BorderBrush="#40808080" BorderThickness="1"/>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </fa:SettingsExpanderItem.Footer>
                    </fa:SettingsExpanderItem>
                </fa:SettingsExpander.Items>
            </fa:SettingsExpander>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xF2D3;}"
                                 Header="长内容滚动"
                                 Description="内容超过设定字数时改为左右滚动显示；设为 0 不启用滚动">
                <fa:SettingsExpander.Footer>
                    <NumericUpDown Value="{Binding Settings.ScrollMaxLength, Mode=TwoWay}"
                                   VerticalAlignment="Center"
                                   FormatString="0"
                                   Minimum="0"
                                   Maximum="500"
                                   InputMethod.IsInputMethodEnabled="False"
                                   MinWidth="60"/>
                </fa:SettingsExpander.Footer>
                <fa:SettingsExpander.Items>
                    <fa:SettingsExpanderItem Content="滚动速度"
                                             Description="每秒滚动的像素数；数值越大越快">
                        <fa:SettingsExpanderItem.Footer>
                            <NumericUpDown Value="{Binding Settings.ScrollSpeedPixelsPerSecond, Mode=TwoWay}"
                                           VerticalAlignment="Center"
                                           FormatString="0"
                                           Minimum="5"
                                           Maximum="500"
                                           InputMethod.IsInputMethodEnabled="False"
                                           MinWidth="70"/>
                        </fa:SettingsExpanderItem.Footer>
                    </fa:SettingsExpanderItem>
                </fa:SettingsExpander.Items>
            </fa:SettingsExpander>
            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE3DA;}"
                                 Header="排除列表"
                                 Description="包含位于此列表中的字符串的内容更新将被忽略,一行一个;可从文本文件导入(文件不超过1MB,总计不超过5000条)">
                <fa:SettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Click="ImportIgnoreListButton_OnClick">
                            <ci:FluentIcon Glyph="&#xE105;"/>
                        </Button>
                        <ci:FluentIcon Glyph="&#xEBD8;"/>
                    </StackPanel>
                </fa:SettingsExpander.Footer>
                <TextBox Text="{Binding Settings.IgnoreListString, Mode=TwoWay}"
                         Background="Transparent"
                         AcceptsReturn="True"
                         VerticalContentAlignment="Top"
                         TextWrapping="Wrap"
                         Margin="6,6,6,6"/>
            </fa:SettingsExpander>
        </StackPanel>
    </ScrollViewer>
</ci:ComponentBase>
