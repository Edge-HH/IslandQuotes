<ci:SettingsPageBase x:Class="IslandQuotes.SettingsPages.AiSettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     mc:Ignorable="d" d:DesignHeight="760" d:DesignWidth="720"
                     AttachedToVisualTree="OnAttachedToVisualTree">
    <ci:SettingsPageBase.Resources>
        <ControlTheme x:Key="SegmentRadioTheme" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="22,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            </Style>
            <Style Selector="^:checked">
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
            </Style>
        </ControlTheme>
    </ci:SettingsPageBase.Resources>
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro" Spacing="10">
            <TextBlock Text="AI审查设置" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="审计失败的内容不会自动放行"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Border Background="#204169e1" CornerRadius="4" Padding="10">
                <StackPanel Spacing="4">
                    <TextBlock Text="供应商与隐私说明" FontWeight="SemiBold"/>
                    <TextBlock Text="待审文本会发送给所选供应商，请先阅读其隐私政策；选择本地 Ollama 时内容不会离开本机。API 密钥只保存在本机插件设置文件中。"
                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
                <StackPanel Spacing="10">
                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="4"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <RadioButton Theme="{StaticResource SegmentRadioTheme}" GroupName="AiProviderMode"
                                         Content="第三方模型提供商" IsChecked="{Binding IsThirdPartyMode, Mode=TwoWay}"/>
                            <RadioButton Theme="{StaticResource SegmentRadioTheme}" GroupName="AiProviderMode"
                                         Content="自定义模型 API" IsChecked="{Binding IsCustomMode, Mode=TwoWay}"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding ModeDescription}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                    <StackPanel Spacing="4" Margin="0,4,0,0" IsVisible="{Binding IsThirdPartyMode}">
                        <TextBlock Text="提供商" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding ThirdPartyProfiles}"
                                  SelectedItem="{Binding SelectedThirdPartyProfile, Mode=TwoWay}"
                                  MinWidth="280">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding DisplayLabel}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="4" Margin="0,4,0,0" IsVisible="{Binding IsCustomMode}">
                        <TextBlock Text="API 地址" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding SelectedProfile.BaseUrl, Mode=TwoWay}"
                                 Watermark="{Binding BaseUrlWatermark}"/>
                    </StackPanel>
                    <StackPanel Spacing="4" IsVisible="{Binding IsCustomMode}">
                        <TextBlock Text="协议" FontWeight="SemiBold"/>
                        <ComboBox ItemsSource="{Binding Protocols}"
                                  SelectedItem="{Binding SelectedProtocolChoice, Mode=TwoWay}"
                                  MinWidth="280">
                            <ComboBox.ItemTemplate>
                                <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="API 密钥" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Width="20" Height="20" CornerRadius="10" BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="Transparent"
                                    ToolTip.Tip="可直接填写密钥，或填写 env:环境变量名 从环境变量读取。密钥只保存在本机插件设置文件中，日志中会被脱敏。">
                                <TextBlock Text="?" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBox Text="{Binding SelectedApiKey, Mode=TwoWay}"
                                 PasswordChar="*" Watermark="填写 API 密钥，或 env:环境变量名"/>
                        <TextBlock Text="未填写 API 密钥。请填写密钥，或使用 env:环境变量名 引用环境变量。"
                                   TextWrapping="Wrap" IsVisible="{Binding ShowApiKeyWarning}"
                                   Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                    </StackPanel>

                    <Separator Margin="0,4"/>

                    <Expander Header="自定义设置" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="4" IsVisible="{Binding IsThirdPartyMode}">
                                <TextBlock Text="API 地址" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding SelectedProfile.BaseUrl, Mode=TwoWay}"
                                         Watermark="{Binding BaseUrlWatermark}"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="请求超时（秒）" FontWeight="SemiBold"/>
                                <NumericUpDown Value="{Binding SelectedProfile.TimeoutSeconds, Mode=TwoWay}"
                                               Minimum="5" Maximum="180" FormatString="0"
                                               InputMethod.IsInputMethodEnabled="False"
                                               HorizontalAlignment="Left" MinWidth="140"/>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="额外请求头（JSON）" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding SelectedProfile.ExtraHeadersJson, Mode=TwoWay}"
                                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64"
                                         Watermark="{}{&quot;X-Custom-Header&quot;: &quot;value&quot;}"/>
                            </StackPanel>
                            <ToggleSwitch IsChecked="{Binding SelectedProfile.IsEnabled, Mode=TwoWay}"
                                          OnContent="启用此预设" OffContent="停用此预设"/>
                        </StackPanel>
                    </Expander>

                    <Separator Margin="0,4"/>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="模型" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="获取可用模型" Click="FetchModelsButton_OnClick"
                                IsEnabled="{Binding IsIdle}"/>
                    </Grid>
                    <TextBox Text="{Binding SelectedModel, Mode=TwoWay}" Watermark="模型名称或部署名"/>
                    <ComboBox ItemsSource="{Binding AvailableModels}"
                              SelectedItem="{Binding SelectedAvailableModel, Mode=TwoWay}"
                              IsVisible="{Binding HasAvailableModels}"
                              PlaceholderText="从已获取的模型中选择"
                              HorizontalAlignment="Stretch"/>
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="审查策略与队列" FontWeight="SemiBold" FontSize="17"/>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12" RowSpacing="8" RowDefinitions="Auto,Auto">
                        <StackPanel Grid.Row="0" Grid.Column="0" Spacing="3">
                            <TextBlock Text="AI 审查失败时" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding FailureActionOptions}"
                                      SelectedItem="{Binding FailureActionChoice, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Spacing="3">
                            <TextBlock Text="最大队列长度" FontWeight="SemiBold"
                                       ToolTip.Tip="队列不多于提前审查阈值时，一次请求审查「最大队列长度 - 当前队列长度」条，使队列保持满载；存在不审查的来源时使用更大的直通缓冲"/>
                            <NumericUpDown Value="{Binding MaxQueueLength, Mode=TwoWay}"
                                           Minimum="1" Maximum="20" FormatString="0"
                                           InputMethod.IsInputMethodEnabled="False"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Spacing="3">
                            <TextBlock Text="提前审查阈值" FontWeight="SemiBold"
                                       ToolTip.Tip="播放队列不多于该数量时，立即在后台补充；设为 0 则等队列播完再补充。存在不审查的来源时会自动提高到直通缓冲的一半"/>
                            <NumericUpDown Value="{Binding RefillThreshold, Mode=TwoWay}"
                                           Minimum="0" Maximum="100" FormatString="0"
                                           InputMethod.IsInputMethodEnabled="False"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Spacing="3">
                            <TextBlock Text="最大尝试次数" FontWeight="SemiBold"
                                       ToolTip.Tip="AI 审查出错时重新请求，直到成功或达到该次数（含首次）"/>
                            <NumericUpDown Value="{Binding MaxReviewAttempts, Mode=TwoWay}"
                                           Minimum="1" Maximum="10" FormatString="0"
                                           InputMethod.IsInputMethodEnabled="False"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Spacing="3">
                            <TextBlock Text="全局请求超时（秒）" FontWeight="SemiBold"/>
                            <NumericUpDown Value="{Binding RequestTimeoutSeconds, Mode=TwoWay}"
                                           Minimum="5" Maximum="180" FormatString="0"
                                           InputMethod.IsInputMethodEnabled="False"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="2" Spacing="3">
                            <TextBlock Text="历史记录上限" FontWeight="SemiBold"/>
                            <NumericUpDown Value="{Binding MaxHistoryItems, Mode=TwoWay}"
                                           Minimum="10" Maximum="100000" FormatString="0"
                                           InputMethod.IsInputMethodEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="提示词快速控制" FontWeight="SemiBold" FontSize="17"/>

                    <StackPanel Spacing="4">
                        <TextBlock Text="判断严格程度" FontWeight="SemiBold"/>
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="4"
                                HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <RadioButton Theme="{StaticResource SegmentRadioTheme}" GroupName="ReviewStrictness"
                                             Content="严格" IsChecked="{Binding IsStrictMode, Mode=TwoWay}"
                                             ToolTip.Tip="从严判定；低风险但置信度不足时仍转人工复核"/>
                                <RadioButton Theme="{StaticResource SegmentRadioTheme}" GroupName="ReviewStrictness"
                                             Content="均衡（默认）" IsChecked="{Binding IsBalancedMode, Mode=TwoWay}"
                                             ToolTip.Tip="低风险放行，中风险转人工，高风险拦截"/>
                                <RadioButton Theme="{StaticResource SegmentRadioTheme}" GroupName="ReviewStrictness"
                                             Content="宽松" IsChecked="{Binding IsRelaxedMode, Mode=TwoWay}"
                                             ToolTip.Tip="只拦截明确不当内容；中风险自动放行，高风险仍拦截"/>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="{Binding StrictnessDescription}" FontSize="12" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="禁止的主题" FontWeight="SemiBold"
                                   ToolTip.Tip="命中这些主题的内容一律拦截：提示词要求判为高风险，本地也会强制执行"/>
                        <ItemsControl ItemsSource="{Binding BlockedTagOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Content="{Binding Label}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Margin="0,0,6,6" Padding="12,5" CornerRadius="6"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBox Text="{Binding CustomTagText, Mode=TwoWay}" Watermark="自定义禁止主题"
                                     KeyDown="CustomTagTextBox_OnKeyDown"/>
                            <Button Grid.Column="1" Content="添加" Click="AddCustomTagButton_OnClick"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="审查提示词" FontWeight="SemiBold" FontSize="17" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="恢复默认" Click="ResetReviewRulesButton_OnClick"/>
                    </Grid>
                    <TextBox Text="{Binding SystemPrompt, Mode=TwoWay}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="150"/>
                </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel Spacing="8">
                    <TextBlock Text="审计日志" FontWeight="SemiBold" FontSize="17"/>
                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="16">
                        <ToggleSwitch Grid.Column="0" IsChecked="{Binding LogEnabled, Mode=TwoWay}"
                                      OnContent="启用日志" OffContent="停用日志"/>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding LogFullPrompts, Mode=TwoWay}"
                                      OnContent="记录完整提示词" OffContent="提示词脱敏/截断"/>
                        <ToggleSwitch Grid.Column="2" IsChecked="{Binding LogFullResponses, Mode=TwoWay}"
                                      OnContent="记录完整响应" OffContent="响应脱敏/截断"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="12">
                        <TextBlock Text="日志保留天数" VerticalAlignment="Center"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding RetentionDays, Mode=TwoWay}"
                                       Minimum="1" Maximum="3650" FormatString="0"
                                       InputMethod.IsInputMethodEnabled="False" MinWidth="120"/>
                    </Grid>
                    <TextBlock Text="日志目录包含审查、拦截、人工复核和播放事件；密钥与 Authorization 请求头会被脱敏。"
                               FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Button Content="打开审计日志目录" Click="OpenLogDirectoryButton_OnClick"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <StackPanel Spacing="4" Margin="0,4,0,0">
                <TextBlock Text="测试文本" FontWeight="SemiBold"/>
                <TextBox Text="{Binding TestText, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="56" Watermark="留空则使用内置的良性测试文本"/>
                <TextBlock Text="点击「测试连接」会保存设置，并用当前供应商审查这段文本，显示其风险评级。"
                           FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <Button Grid.Column="1" Content="保存设置" Click="SaveButton_OnClick"
                        IsEnabled="{Binding IsIdle}" MinWidth="110"/>
                <Button Grid.Column="2" Content="测试连接" Click="TestButton_OnClick"
                        IsEnabled="{Binding IsIdle}" MinWidth="110"/>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>

